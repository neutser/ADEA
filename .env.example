# Adea Crafts - Environment Variables
# Copy this file to .env and fill in the values

# ── Required (Production) ───────────────────────────────────
# JWT signing secret. MUST be set in production. Generate with: openssl rand -hex 32
JWT_SECRET=

# ── API & Frontend ───────────────────────────────────────────
# API base URL for the frontend (e.g. http://localhost:3001)
VITE_API_URL=

# Frontend URL for Stripe redirects and CORS (e.g. http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# ── Stripe (Checkout) ───────────────────────────────────────
# Optional. When not set, checkout falls back to direct order flow.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_SECRET_KEY=sk_live_...

# ── AI (OpenAI) ──────────────────────────────────────────────
# Server-side only. NEVER use VITE_OPENAI_API_KEY — it would expose the key to the client.
# Required for: design assistant, generative design, scene analysis, machine assistant.
OPENAI_API_KEY=sk-...

# ── Optional ──────────────────────────────────────────────────
# Server port (default: 3001)
# PORT=3001

# Node environment (production enables strict JWT_SECRET check)
# NODE_ENV=production
